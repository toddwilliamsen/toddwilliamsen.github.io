---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for entry in site.pages -%}
  {%- unless entry.sitemap == false or entry.url == '/sitemap.xml' or entry.url == '/robots.txt' %}
  <url>
    <loc>{{ site.url | append: entry.url | xml_escape }}</loc>
    {%- if entry.date %}
    <lastmod>{{ entry.date | date: '%Y-%m-%d' }}</lastmod>
    {%- endif %}
  </url>
  {%- endunless -%}
{%- endfor %}
</urlset>
