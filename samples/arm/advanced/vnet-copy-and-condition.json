{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Sample: copy loops for subnets + conditional Bastion-related public IP. Demonstrates advanced patterns without needing a full hub deployment."
  },
  "parameters": {
    "environment": {
      "type": "string",
      "allowedValues": [ "dev", "test", "prod" ]
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "deployBastionPublicIp": {
      "type": "bool",
      "defaultValue": false,
      "metadata": { "description": "Set true only when you actually intend to deploy Bastion-related public IP." }
    },
    "subnets": {
      "type": "array",
      "defaultValue": [
        { "name": "snet-app", "prefix": "10.40.1.0/24" },
        { "name": "snet-data", "prefix": "10.40.2.0/24" },
        { "name": "snet-pe", "prefix": "10.40.3.0/24" }
      ]
    }
  },
  "variables": {
    "vnetName": "[concat('vnet-', parameters('environment'), '-hub')]",
    "pipName": "[concat('pip-bastion-', parameters('environment'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2023-09-01",
      "name": "[variables('vnetName')]",
      "location": "[parameters('location')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [ "10.40.0.0/16" ]
        },
        "copy": [
          {
            "name": "subnets",
            "count": "[length(parameters('subnets'))]",
            "input": {
              "name": "[parameters('subnets')[copyIndex('subnets')].name]",
              "properties": {
                "addressPrefix": "[parameters('subnets')[copyIndex('subnets')].prefix]"
              }
            }
          }
        ]
      }
    },
    {
      "condition": "[parameters('deployBastionPublicIp')]",
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2023-09-01",
      "name": "[variables('pipName')]",
      "location": "[parameters('location')]",
      "sku": { "name": "Standard" },
      "properties": {
        "publicIPAllocationMethod": "Static"
      }
    }
  ],
  "outputs": {
    "vnetId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/virtualNetworks', variables('vnetName'))]"
    },
    "subnetCount": {
      "type": "int",
      "value": "[length(parameters('subnets'))]"
    },
    "bastionPublicIpDeployed": {
      "type": "bool",
      "value": "[parameters('deployBastionPublicIp')]"
    }
  }
}
