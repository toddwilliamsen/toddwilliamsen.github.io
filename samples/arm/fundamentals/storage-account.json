{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Sample: secure-ish storage account with tags, TLS, and public access decisions made explicit. Educational — not a full landing-zone module."
  },
  "parameters": {
    "environment": {
      "type": "string",
      "allowedValues": [ "dev", "test", "prod" ],
      "metadata": { "description": "Environment name used in naming and tags." }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "Azure region." }
    },
    "owner": {
      "type": "string",
      "metadata": { "description": "Human or team accountable for this resource." }
    },
    "costCenter": {
      "type": "string",
      "metadata": { "description": "Cost center / billing tag." }
    },
    "allowBlobPublicAccess": {
      "type": "bool",
      "defaultValue": false,
      "metadata": { "description": "Explicit public blob access decision. Prefer false." }
    },
    "skuName": {
      "type": "string",
      "defaultValue": "Standard_LRS",
      "allowedValues": [ "Standard_LRS", "Standard_GRS", "Standard_ZRS" ]
    }
  },
  "variables": {
    "storageName": "[toLower(concat('st', parameters('environment'), uniqueString(resourceGroup().id)))]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[variables('storageName')]",
      "location": "[parameters('location')]",
      "tags": {
        "environment": "[parameters('environment')]",
        "owner": "[parameters('owner')]",
        "costCenter": "[parameters('costCenter')]",
        "dataClassification": "internal"
      },
      "sku": {
        "name": "[parameters('skuName')]"
      },
      "kind": "StorageV2",
      "properties": {
        "minimumTlsVersion": "TLS1_2",
        "allowBlobPublicAccess": "[parameters('allowBlobPublicAccess')]",
        "supportsHttpsTrafficOnly": true,
        "networkAcls": {
          "defaultAction": "Deny",
          "bypass": "AzureServices"
        }
      }
    }
  ],
  "outputs": {
    "storageAccountName": {
      "type": "string",
      "value": "[variables('storageName')]"
    },
    "storageAccountId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"
    }
  }
}
